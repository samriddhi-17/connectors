# ==============================================================
# Connects demo — configuration (copy to .env and edit)
# Nothing is hard-coded: every knob in the project reads from
# environment variables. The .env file is consumed by:
#   * the FastAPI backend   (pydantic-settings)
#   * podman-compose        (${VAR} interpolation)
#   * the deploy scripts    (kubectl create secret/configmap)
# ==============================================================

# ---- Application ----
APP_NAME=connects-demo
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=*
METRICS_PREFIX=demo

# ---- Aerospike connector ----
AEROSPIKE_ENABLED=true
AEROSPIKE_HOST=localhost
AEROSPIKE_PORT=3000
AEROSPIKE_NAMESPACE=test
AEROSPIKE_SET_NAME=demo
AEROSPIKE_AUTH_MODE=none
AEROSPIKE_USERNAME=
AEROSPIKE_PASSWORD=
AEROSPIKE_CONNECT_TIMEOUT_S=3
AEROSPIKE_QUERY_TIMEOUT_S=5

# ---- Yugabyte connector ----
YUGABYTE_ENABLED=true
YUGABYTE_HOST=localhost
YUGABYTE_PORT=5433
YUGABYTE_DATABASE=yugabyte
YUGABYTE_USER=yugabyte
YUGABYTE_PASSWORD=yugabyte
YUGABYTE_SSLMODE=disable
YUGABYTE_TABLE_NAME=demo_records
YUGABYTE_POOL_MIN=1
YUGABYTE_POOL_MAX=5

# ---- OpenSRE bridge (webhook -> OpenSRE-compatible alert JSON) ----
OPENSRE_ALERTS_DIR=./opensre/alerts
OPENSRE_INVOKE_CLI=false
OPENSRE_BIN=opensre
OPENSRE_CLI_TIMEOUT_S=120
# Mirrors the OpenSRE CLI's own Grafana integration env vars so the demo
# instance can connect OpenSRE back to the demo Grafana for evidence.
OPENSRE_GRAFANA_INSTANCE_URL=http://localhost:3000
OPENSRE_GRAFANA_READ_TOKEN=
OPENSRE_GRAFANA_VERIFY_SSL=true

# ---- Frontend (runtime config injected by nginx entrypoint) ----
VITE_API_BASE=
VITE_GRAFANA_URL=http://localhost:3000

# ---- Grafana / Prometheus ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ALERT_WEBHOOK_URL=http://backend:8000/api/v1/alerts
PROMETHEUS_URL=http://prometheus:9090

# ---- Containers / compose ----
IMAGE_TAG=local
BACKEND_PORT=8000
FRONTEND_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ---- Images (override to pin versions) ----
AEROSPIKE_IMAGE=aerospike/aerospike-server:7.0.0.6
YUGABYTE_IMAGE=yugabytedb/yugabyte:2.23.1.0-b220
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.5.2