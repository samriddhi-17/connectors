# Secrets for the demo. Copy this to k8s/secret.env (git-ignored) and fill
# in real values; the deploy script creates the `connects-secrets` Secret
# from it. Defaults below match the local compose stack for convenience.
#
#   Copy-Item k8s\secret.env.example k8s\secret.env
YUGABYTE_PASSWORD=yugabyte
OPENSRE_GRAFANA_READ_TOKEN=
GRAFANA_ADMIN_PASSWORD=admin